{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appliedaischool.example/schemas/run-record.schema.json",
  "title": "Immutable safety-evaluation item record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "experiment_id", "item_id", "model", "check", "environment", "status", "started_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string"},
    "experiment_id": {"type": "string"},
    "item_id": {"type": "string"},
    "model": {"type": "object", "required": ["family_id", "model_alias", "revision", "backend", "precision", "quantization"]},
    "check": {"type": "object", "required": ["check_id", "dataset_revision", "prompt_version", "scoring_version"]},
    "environment": {"type": "object", "required": ["machine", "software"]},
    "status": {"enum": ["completed", "failed", "skipped"]},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"},
    "input": {"type": "object"},
    "output": {"type": ["object", "null"]},
    "error": {"type": ["object", "null"]}
  }
}
